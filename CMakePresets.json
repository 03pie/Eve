{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CORDIS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "core-gcc-debug",
      "inherits": "base",
      "displayName": "Portable core / GCC / Debug",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "core-gcc-release",
      "inherits": "core-gcc-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "core-msvc-debug",
      "inherits": "base",
      "displayName": "Target core / MSVC / Debug (developer shell required)",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL"
      }
    },
    {
      "name": "core-msvc-release",
      "inherits": "core-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      }
    },
    {
      "name": "qt-msvc-debug",
      "inherits": "core-msvc-debug",
      "displayName": "Qt 5.15.2 / MSVC / Debug",
      "cacheVariables": {
        "CORDIS_REQUIRE_QT5152": "ON",
        "CMAKE_PREFIX_PATH": "$env{CORDIS_QT5152_ROOT}"
      }
    },
    {
      "name": "qt-msvc-release",
      "inherits": "qt-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      }
    }
  ],
  "buildPresets": [
    { "name": "core-gcc-debug", "configurePreset": "core-gcc-debug" },
    { "name": "core-gcc-release", "configurePreset": "core-gcc-release" },
    { "name": "core-msvc-debug", "configurePreset": "core-msvc-debug" },
    { "name": "core-msvc-release", "configurePreset": "core-msvc-release" },
    { "name": "qt-msvc-debug", "configurePreset": "qt-msvc-debug" },
    { "name": "qt-msvc-release", "configurePreset": "qt-msvc-release" }
  ],
  "testPresets": [
    { "name": "core-gcc-debug", "configurePreset": "core-gcc-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "core-gcc-release", "configurePreset": "core-gcc-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "core-msvc-debug", "configurePreset": "core-msvc-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "core-msvc-release", "configurePreset": "core-msvc-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "qt-msvc-debug", "configurePreset": "qt-msvc-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "qt-msvc-release", "configurePreset": "qt-msvc-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
