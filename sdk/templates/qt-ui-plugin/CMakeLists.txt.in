cmake_minimum_required(VERSION 3.21)
project(ExternalEvePage VERSION 1.0.0 LANGUAGES CXX)

find_package(Eve @EVE_SDK_VERSION@ EXACT CONFIG REQUIRED COMPONENTS QtUiPluginSdk)
eve_add_qt_ui_plugin(external_page
    SOURCE plugin.cpp
    MODULE_ID org.example.eve.page
    PLUGIN_ID example.page
    MODULE_VERSION ${PROJECT_VERSION})
eve_add_extension_package(external_page PACKAGE_JSON package.json README README.md)
