include_guard(GLOBAL)

# This reader consumes reviewed data only. It never opens a DLL or its current manifest.
function(_cordis_catalog_value output json type)
    string(JSON actual ERROR_VARIABLE problem TYPE "${json}" ${ARGN})
    if(problem OR NOT actual STREQUAL type)
        message(FATAL_ERROR "Invalid Native qualification field (${ARGN}): expected ${type}")
    endif()
    string(JSON value GET "${json}" ${ARGN})
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_cordis_catalog_keys json expected)
    _cordis_catalog_value(value "${json}" OBJECT ${ARGN})
    string(JSON count LENGTH "${json}" ${ARGN})
    list(LENGTH expected expected_count)
    if(NOT count EQUAL expected_count)
        message(FATAL_ERROR "Invalid Native qualification object fields (${ARGN})")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON member MEMBER "${json}" ${ARGN} ${index})
        if(NOT member IN_LIST expected)
            message(FATAL_ERROR "Unknown Native qualification field: ${member}")
        endif()
    endforeach()
endfunction()

function(_cordis_catalog_text output json)
    _cordis_catalog_value(value "${json}" STRING ${ARGN})
    string(LENGTH "${value}" length)
    if(length EQUAL 0 OR length GREATER 16384 OR value MATCHES "[\r\n;]")
        message(FATAL_ERROR "Invalid Native qualification text (${ARGN})")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_cordis_catalog_sha json)
    _cordis_catalog_text(value "${json}" ${ARGN})
    string(LENGTH "${value}" length)
    if(NOT length EQUAL 64 OR NOT value MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid Native qualification SHA256 (${ARGN})")
    endif()
endfunction()

function(_cordis_catalog_records json field)
    _cordis_catalog_value(records "${json}" ARRAY ${field})
    string(JSON count LENGTH "${records}")
    if(count LESS 1 OR count GREATER 2048)
        message(FATAL_ERROR "Invalid Native qualification provenance count")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        _cordis_catalog_keys("${records}" "role;path;sha256" ${index})
        _cordis_catalog_text(role "${records}" ${index} role)
        _cordis_catalog_text(path "${records}" ${index} path)
        _cordis_catalog_sha("${records}" ${index} sha256)
    endforeach()
endfunction()

function(_cordis_catalog_runtime output configuration runtime)
    if(runtime STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
        if(configuration STREQUAL "Debug")
            set(runtime "MultiThreadedDebugDLL")
        else()
            set(runtime "MultiThreadedDLL")
        endif()
    endif()
    if(runtime STREQUAL "MultiThreadedDLL")
        set(value MD)
    elseif(runtime STREQUAL "MultiThreadedDebugDLL")
        set(value MDd)
    else()
        set(value "unknown")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(cordis_native_product_catalog out_source)
    set(path "${PROJECT_SOURCE_DIR}/qualification/native-business-p6-3-20261123.json")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Reviewed Native qualification is missing: ${path}")
    endif()
    file(SIZE "${path}" size)
    if(size LESS 1 OR size GREATER 2097152)
        message(FATAL_ERROR "Reviewed Native qualification has an invalid size")
    endif()
    file(SHA256 "${path}" catalog_sha256)
    if(NOT catalog_sha256 STREQUAL "44758309aede7a215874d4d8307fd3421e20da2befbdd5f288516de5b7382246")
        message(FATAL_ERROR "Reviewed Native qualification SHA256 differs from the explicitly adopted source")
    endif()
    file(READ "${path}" catalog)
    _cordis_catalog_keys("${catalog}" "schema;profiles;provenance")
    _cordis_catalog_text(schema "${catalog}" schema)
    if(NOT schema STREQUAL "cordis.native-business.qualification/1")
        message(FATAL_ERROR "Unsupported Native qualification schema")
    endif()
    _cordis_catalog_keys("${catalog}"
        "method;exportCheckoutCommit;exporterSha256;qualificationSources;pendingStages;evidence" provenance)
    _cordis_catalog_text(method "${catalog}" provenance method)
    if(NOT method STREQUAL "historical-import" AND NOT method STREQUAL "current-capture")
        message(FATAL_ERROR "Invalid qualification export provenance method")
    endif()
    _cordis_catalog_text(commit "${catalog}" provenance exportCheckoutCommit)
    string(LENGTH "${commit}" commit_length)
    if(NOT commit_length EQUAL 40 OR NOT commit MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid qualification export checkout commit")
    endif()
    _cordis_catalog_sha("${catalog}" provenance exporterSha256)
    _cordis_catalog_value(sources "${catalog}" ARRAY provenance qualificationSources)
    string(JSON source_count LENGTH "${sources}")
    _cordis_catalog_value(pending "${catalog}" ARRAY provenance pendingStages)
    string(JSON pending_count LENGTH "${pending}")
    if(source_count LESS 1 OR source_count GREATER 8 OR NOT pending_count EQUAL 2)
        message(FATAL_ERROR "Incomplete Native qualification stage provenance")
    endif()
    math(EXPR last_source "${source_count} - 1")
    foreach(index RANGE ${last_source})
        _cordis_catalog_keys("${sources}" "stage;commit;inputManifest;inputManifestSha256" ${index})
        _cordis_catalog_text(stage "${sources}" ${index} stage)
        _cordis_catalog_text(commit "${sources}" ${index} commit)
        string(LENGTH "${commit}" commit_length)
        if(NOT commit_length EQUAL 40 OR NOT commit MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "Invalid original qualification source")
        endif()
        _cordis_catalog_text(input "${sources}" ${index} inputManifest)
        _cordis_catalog_sha("${sources}" ${index} inputManifestSha256)
    endforeach()
    _cordis_catalog_value(pending_e2 "${pending}" STRING 0)
    _cordis_catalog_value(pending_e3 "${pending}" STRING 1)
    if(NOT pending_e2 STREQUAL "M5-e2" OR NOT pending_e3 STREQUAL "M5-e3")
        message(FATAL_ERROR "Qualification cannot claim pending release/desktop stages")
    endif()
    _cordis_catalog_value(provenance "${catalog}" OBJECT provenance)
    _cordis_catalog_records("${provenance}" evidence)
    _cordis_catalog_value(profiles "${catalog}" ARRAY profiles)
    string(JSON profile_count LENGTH "${profiles}")
    if(NOT profile_count EQUAL 3)
        message(FATAL_ERROR "Native qualification requires exactly three measured profiles")
    endif()
    set(identities)
    foreach(profile_index RANGE 0 2)
        _cordis_catalog_keys("${profiles}"
            "id;platform;compiler;compilerVersion;buildType;runtime;runtimeDefinition;asan;cxxFlags;configurationFlags;sdkVersion;qtVersion;pointerBits;cppStandard;products;dependencies"
            ${profile_index})
        string(JSON profile GET "${profiles}" ${profile_index})
        foreach(field IN ITEMS id platform compiler compilerVersion buildType runtime runtimeDefinition cxxFlags
                configurationFlags sdkVersion qtVersion)
            _cordis_catalog_text(value "${profile}" ${field})
            set(profile_${field} "${value}")
        endforeach()
        _cordis_catalog_value(profile_asan "${profile}" BOOLEAN asan)
        _cordis_catalog_value(bits "${profile}" NUMBER pointerBits)
        _cordis_catalog_value(standard "${profile}" NUMBER cppStandard)
        if(profile_id IN_LIST identities OR NOT profile_platform STREQUAL "windows-x64" OR
                NOT profile_compiler STREQUAL "MSVC" OR NOT bits STREQUAL "64" OR NOT standard STREQUAL "201703" OR
                NOT profile_compilerVersion MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" OR
                NOT profile_sdkVersion MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$" OR
                NOT profile_qtVersion STREQUAL "5.15.2")
            message(FATAL_ERROR "Invalid Native qualification profile identity")
        endif()
        list(APPEND identities "${profile_id}")
        if(profile_id STREQUAL "ela-msvc-release")
            set(expected_build Release)
            set(expected_runtime MD)
            set(expected_asan OFF)
        elseif(profile_id STREQUAL "ela-msvc-debug")
            set(expected_build Debug)
            set(expected_runtime MDd)
            set(expected_asan OFF)
        elseif(profile_id STREQUAL "p3-q3-asan")
            set(expected_build RelWithDebInfo)
            set(expected_runtime MD)
            set(expected_asan ON)
        else()
            message(FATAL_ERROR "Unknown qualified Native profile")
        endif()
        if(NOT profile_buildType STREQUAL expected_build OR NOT profile_runtime STREQUAL expected_runtime OR
                NOT profile_asan STREQUAL expected_asan)
            message(FATAL_ERROR "Inconsistent qualified Native build/CRT/ASan identity")
        endif()
        _cordis_catalog_runtime(declared_runtime "${profile_buildType}" "${profile_runtimeDefinition}")
        if(NOT declared_runtime STREQUAL profile_runtime)
            message(FATAL_ERROR "Qualified profile CRT definition is inconsistent")
        endif()
        _cordis_catalog_records("${profile}" dependencies)
        _cordis_catalog_value(products "${profile}" ARRAY products)
        string(JSON product_count LENGTH "${products}")
        if(NOT product_count EQUAL 4)
            message(FATAL_ERROR "Each profile must contain only four Native business products")
        endif()
        set(product_keys)
        set(rows "")
        foreach(product_index RANGE 0 3)
            _cordis_catalog_keys("${products}"
                "moduleId;pluginId;moduleVersion;loader;unloadPolicy;sha256;manifestSha256;library;manifest;producerSource;producerSha256;producerCommand;compileCommandSha256"
                ${product_index})
            foreach(field IN ITEMS moduleId pluginId moduleVersion loader unloadPolicy sha256 manifestSha256 library
                    manifest producerSource producerSha256 producerCommand compileCommandSha256)
                _cordis_catalog_text(product_${field} "${products}" ${product_index} ${field})
            endforeach()
            foreach(field IN ITEMS sha256 manifestSha256 producerSha256 compileCommandSha256)
                _cordis_catalog_sha("${products}" ${product_index} ${field})
            endforeach()
            if(product_moduleId STREQUAL "org.cordis.example.counter")
                set(name counter)
            elseif(product_moduleId STREQUAL "org.cordis.example.reporter")
                set(name reporter)
            else()
                message(FATAL_ERROR "Unqualified module identity in Native product catalog")
            endif()
            if(product_moduleVersion STREQUAL "1.1.0")
                set(variant a)
            elseif(product_moduleVersion STREQUAL "1.2.0")
                set(variant b)
            else()
                message(FATAL_ERROR "Unqualified Native business version")
            endif()
            set(key "${name}-${variant}")
            if(key IN_LIST product_keys OR NOT product_pluginId STREQUAL "example.${name}" OR
                    NOT product_loader STREQUAL "c-abi" OR NOT product_unloadPolicy STREQUAL "explicit" OR
                    NOT product_library STREQUAL "native-upgrade/${key}/cordis_example_${name}_${variant}.dll" OR
                    NOT product_manifest STREQUAL "native-upgrade/${key}/module.json" OR
                    NOT product_producerSource STREQUAL "examples/native_services/${name}.cpp")
                message(FATAL_ERROR "Invalid or duplicate Native product identity/locator")
            endif()
            string(SHA256 command_sha "${product_producerCommand}")
            if(NOT command_sha STREQUAL product_compileCommandSha256)
                message(FATAL_ERROR "Native producer command provenance does not match its SHA")
            endif()
            list(APPEND product_keys "${key}")
            string(APPEND rows "        {\"${product_moduleId}\", \"${product_sha256}\"},\n")
        endforeach()
        set(qualified_${profile_index} "${profile}")
        set(qualified_rows_${profile_index} "${rows}")
    endforeach()
    if(CMAKE_CONFIGURATION_TYPES)
        set(configurations ${CMAKE_CONFIGURATION_TYPES})
    elseif(CMAKE_BUILD_TYPE)
        set(configurations "${CMAKE_BUILD_TYPE}")
    else()
        set(configurations __unconfigured)
    endif()
    if(DEFINED Qt5Core_VERSION_STRING)
        set(qt_version "${Qt5Core_VERSION_STRING}")
    else()
        set(qt_version "${Qt5Core_VERSION}")
    endif()
    math(EXPR pointer_bits "${CMAKE_SIZEOF_VOID_P} * 8")
    if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
        set(runtime_definition "${CMAKE_MSVC_RUNTIME_LIBRARY}")
    else()
        set(runtime_definition "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    endif()
    set(output_directory "${CMAKE_CURRENT_BINARY_DIR}/native-product-catalog")
    file(MAKE_DIRECTORY "${output_directory}")
    foreach(configuration IN LISTS configurations)
        if(configuration STREQUAL __unconfigured)
            set(configuration "")
        endif()
        string(TOUPPER "${configuration}" upper)
        set(configuration_flags "${CMAKE_CXX_FLAGS_${upper}}")
        set(effective_flags "${CMAKE_CXX_FLAGS} ${configuration_flags}")
        if(effective_flags MATCHES "(^|[ \t])[-/]fsanitize=address([ \t]|$)")
            set(asan ON)
        else()
            set(asan OFF)
        endif()
        _cordis_catalog_runtime(runtime "${configuration}" "${runtime_definition}")
        set(rows "")
        set(matches 0)
        foreach(index RANGE 0 2)
            set(profile "${qualified_${index}}")
            set(matched TRUE)
            foreach(pair IN ITEMS "compiler;${CMAKE_CXX_COMPILER_ID}" "compilerVersion;${CMAKE_CXX_COMPILER_VERSION}"
                    "buildType;${configuration}" "runtime;${runtime}" "asan;${asan}"
                    "cxxFlags;${CMAKE_CXX_FLAGS}" "configurationFlags;${configuration_flags}"
                    "sdkVersion;${PROJECT_VERSION}" "qtVersion;${qt_version}" "pointerBits;${pointer_bits}")
                list(GET pair 0 field)
                list(GET pair 1 actual)
                string(JSON expected GET "${profile}" ${field})
                if(NOT actual STREQUAL expected)
                    set(matched FALSE)
                endif()
            endforeach()
            if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows" OR NOT CMAKE_CXX_STANDARD STREQUAL "17")
                set(matched FALSE)
            endif()
            if(matched)
                math(EXPR matches "${matches} + 1")
                set(rows "${qualified_rows_${index}}")
            endif()
        endforeach()
        if(matches GREATER 1)
            message(FATAL_ERROR "Ambiguous exact Native qualification profile")
        endif()
        set(content "// Generated from reviewed qualification/native-business-p6-3-20261123.json (${catalog_sha256}); no runtime approval input.\n#include \"native_catalog_p.hpp\"\n\nnamespace notebook::detail {\ncordis::module::NativeUnloadWhitelist productNativeApprovals()\n{\n    return {\n${rows}    };\n}\n} // namespace notebook::detail\n")
        set(output "${output_directory}/native_catalog_${configuration}.cpp")
        if(EXISTS "${output}")
            file(READ "${output}" previous)
        else()
            set(previous "")
        endif()
        if(NOT previous STREQUAL content)
            file(WRITE "${output}" "${content}")
        endif()
    endforeach()
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    endif()
    if(CMAKE_CONFIGURATION_TYPES)
        set(${out_source} "${output_directory}/native_catalog_$<CONFIG>.cpp" PARENT_SCOPE)
    else()
        set(${out_source} "${output_directory}/native_catalog_${CMAKE_BUILD_TYPE}.cpp" PARENT_SCOPE)
    endif()
endfunction()
