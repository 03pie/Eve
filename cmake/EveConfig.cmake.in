@PACKAGE_INIT@

set(Eve_VERSION "@PROJECT_VERSION@")
set(Eve_SDK_CONFIGURATION "@CMAKE_BUILD_TYPE@")
set(Eve_SDK_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(Eve_SDK_RUNTIME "@eve_sdk_runtime@")
macro(_eve_sdk_reject reason)
    set(Eve_FOUND FALSE)
    set(Eve_NOT_FOUND_MESSAGE "${reason}")
    return()
endmacro()
if(NOT WIN32 OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    _eve_sdk_reject("Eve plugin SDK requires Windows/MSVC/x64 and an enabled CXX language")
endif()
if(NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL Eve_SDK_COMPILER_VERSION)
    _eve_sdk_reject("Eve compiler mismatch: SDK ${Eve_SDK_COMPILER_VERSION}, consumer ${CMAKE_CXX_COMPILER_VERSION}")
endif()
if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL Eve_SDK_CONFIGURATION)
    _eve_sdk_reject("Eve configuration mismatch: use single-configuration ${Eve_SDK_CONFIGURATION}")
endif()
if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL Eve_SDK_RUNTIME
   AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    _eve_sdk_reject("Eve requires ${Eve_SDK_RUNTIME}; static or mismatched MSVC CRT is unsupported")
endif()
foreach(flags IN ITEMS CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_DEBUG CMAKE_CXX_FLAGS_RELEASE)
    if("${${flags}}" MATCHES "(^|[ \t])[-/]MTd?([ \t]|$)")
        _eve_sdk_reject("Eve plugin SDK rejects /MT and /MTd; use the matching dynamic CRT")
    endif()
endforeach()
foreach(component IN LISTS Eve_FIND_COMPONENTS)
    if(NOT component MATCHES "^(Core|Qt|Ui|QtPluginSdk|QtUiPluginSdk)$")
        _eve_sdk_reject("Unsupported Eve SDK component: ${component}; host Module/Session libraries are not plugin SDK components")
    endif()
    set(Eve_${component}_FOUND TRUE)
endforeach()

include(CMakeFindDependencyMacro)
# Save our prefix before dependency configs use PACKAGE_INIT on CMake < 3.30.
set(_eve_sdk_prefix "${PACKAGE_PREFIX_DIR}")
find_dependency(Threads)
find_dependency(Qt5 5.15.2 EXACT COMPONENTS Core Widgets)
find_dependency(ElaWidgetTools 2.0.0 EXACT CONFIG
    PATHS "${_eve_sdk_prefix}/ElaWidgetTools/lib/cmake" NO_DEFAULT_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/EveTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/EvePlugin.cmake")
check_required_components(Eve)
