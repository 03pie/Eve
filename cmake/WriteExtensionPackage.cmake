cmake_minimum_required(VERSION 3.21)
foreach(key IN ITEMS LIBRARY PACKAGE_JSON OUTPUT)
    if(NOT DEFINED ${key} OR NOT IS_ABSOLUTE "${${key}}")
        message(FATAL_ERROR "An absolute ${key} path is required")
    endif()
endforeach()
if(NOT OUTPUT MATCHES "[.]evepkg$")
    message(FATAL_ERROR "Expected an .evepkg output file")
endif()
get_filename_component(directory "${LIBRARY}" DIRECTORY)
get_filename_component(library_name "${LIBRARY}" NAME)
file(READ "${directory}/module.json" manifest)
string(JSON declared GET "${manifest}" library)
string(JSON loader GET "${manifest}" loader)
string(JSON policy GET "${manifest}" unloadPolicy)
string(JSON plugins LENGTH "${manifest}" plugins)
string(JSON expected_hash GET "${manifest}" sha256)
file(SHA256 "${LIBRARY}" hash)
if(NOT loader STREQUAL "qt-ui" OR NOT policy STREQUAL "resident" OR NOT plugins EQUAL 1
   OR NOT declared STREQUAL library_name OR NOT expected_hash STREQUAL hash)
    message(FATAL_ERROR "module.json must describe the supplied resident single-plugin Qt DLL")
endif()
file(READ "${PACKAGE_JSON}" descriptor)
string(JSON version GET "${descriptor}" formatVersion)
string(JSON kind GET "${descriptor}" kind)
foreach(field IN ITEMS name publisher)
    string(JSON field_type TYPE "${descriptor}" ${field})
    string(JSON value GET "${descriptor}" ${field})
    if(NOT field_type STREQUAL "STRING" OR value STREQUAL "")
        message(FATAL_ERROR "${field} must be a nonempty string")
    endif()
endforeach()
if(NOT version STREQUAL "1" OR NOT kind MATCHES "^(business|desktop)$")
    message(FATAL_ERROR "Expected formatVersion 1 and kind business or desktop")
endif()
if(ICON AND NOT EXISTS "${ICON}")
    message(FATAL_ERROR "The declared PNG icon is missing")
endif()

# Stage only the explicitly declared members. Rename the finished ZIP on the same volume.
get_filename_component(parent "${OUTPUT}" DIRECTORY)
string(RANDOM LENGTH 20 ALPHABET "0123456789abcdef" nonce)
set(stage "${parent}/.evepkg-${nonce}")
if(EXISTS "${stage}")
    message(FATAL_ERROR "Packaging staging directory already exists")
endif()
file(MAKE_DIRECTORY "${stage}")
file(COPY_FILE "${PACKAGE_JSON}" "${stage}/package.json")
file(COPY_FILE "${directory}/module.json" "${stage}/module.json")
file(COPY_FILE "${LIBRARY}" "${stage}/${library_name}")
set(entries package.json module.json "${library_name}")
if(ICON)
    file(COPY_FILE "${ICON}" "${stage}/icon.png")
    list(APPEND entries icon.png)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf package.zip --format=zip -- ${entries}
    WORKING_DIRECTORY "${stage}" RESULT_VARIABLE zip_result)
if(zip_result EQUAL 0)
    file(RENAME "${stage}/package.zip" "${OUTPUT}" RESULT zip_result)
endif()
file(REMOVE_RECURSE "${stage}")
if(NOT zip_result STREQUAL "0")
    message(FATAL_ERROR "Failed to publish ${OUTPUT}: ${zip_result}")
endif()
message(STATUS "Built Eve extension package: ${OUTPUT}")
