@PACKAGE_INIT@

set_and_check(EveWorkbench_PRIVATE_INCLUDE_DIR "@PACKAGE_eve_workbench_private_includes@")
set_and_check(EveWorkbench_BRAND_QRC "@PACKAGE_eve_workbench_brand@/eve_brand.qrc")
set_and_check(EveWorkbench_CMAKE_DIR "@PACKAGE_eve_sdk_cmake_dir@")
set_and_check(_workbench_eve_bin "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set_and_check(_workbench_ela_bin "${PACKAGE_PREFIX_DIR}/ElaWidgetTools/bin")
string(TOUPPER "@CMAKE_BUILD_TYPE@" _workbench_config)
foreach(_target IN ITEMS Eve::Core Ela::WidgetTools)
    if(TARGET "${_target}")
        if(_target STREQUAL "Eve::Core")
            set(_expected_bin "${_workbench_eve_bin}")
        else()
            set(_expected_bin "${_workbench_ela_bin}")
        endif()
        get_target_property(_binary "${_target}" "IMPORTED_LOCATION_${_workbench_config}")
        get_filename_component(_bin "${_binary}" DIRECTORY)
        file(REAL_PATH "${_bin}" _bin)
        file(REAL_PATH "${_expected_bin}" _expected_bin)
        string(TOLOWER "${_bin}" _bin)
        string(TOLOWER "${_expected_bin}" _expected_bin)
        if(NOT _bin STREQUAL _expected_bin)
            set(EveWorkbench_FOUND FALSE)
            set(EveWorkbench_NOT_FOUND_MESSAGE "${_target} already comes from a different SDK installation.")
            return()
        endif()
    endif()
endforeach()
# find_package prefers a cached <Package>_DIR even when a PATHS argument uses NO_DEFAULT_PATH.
set(Eve_DIR "${EveWorkbench_CMAKE_DIR}")
set(ElaWidgetTools_DIR "${PACKAGE_PREFIX_DIR}/ElaWidgetTools/lib/cmake")
include(CMakeFindDependencyMacro)
find_dependency(Eve @EVE_SDK_VERSION@ EXACT CONFIG COMPONENTS DesktopSdk
    PATHS "${EveWorkbench_CMAKE_DIR}" NO_DEFAULT_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/EveWorkbenchTargets.cmake")
