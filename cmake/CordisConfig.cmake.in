@PACKAGE_INIT@

set(Cordis_VERSION "@PROJECT_VERSION@")
set(Cordis_SDK_CONFIGURATION "@CMAKE_BUILD_TYPE@")
set(Cordis_SDK_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(Cordis_SDK_RUNTIME "@cordis_sdk_runtime@")
macro(_cordis_sdk_reject reason)
    set(Cordis_FOUND FALSE)
    set(Cordis_NOT_FOUND_MESSAGE "${reason}")
    return()
endmacro()
if(NOT WIN32 OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    _cordis_sdk_reject("Cordis plugin SDK requires Windows/MSVC/x64 and an enabled CXX language")
endif()
if(NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL Cordis_SDK_COMPILER_VERSION)
    _cordis_sdk_reject("Cordis compiler mismatch: SDK ${Cordis_SDK_COMPILER_VERSION}, consumer ${CMAKE_CXX_COMPILER_VERSION}")
endif()
if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL Cordis_SDK_CONFIGURATION)
    _cordis_sdk_reject("Cordis configuration mismatch: use single-configuration ${Cordis_SDK_CONFIGURATION}")
endif()
if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL Cordis_SDK_RUNTIME
   AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    _cordis_sdk_reject("Cordis requires ${Cordis_SDK_RUNTIME}; static or mismatched MSVC CRT is unsupported")
endif()
foreach(flags IN ITEMS CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_DEBUG CMAKE_CXX_FLAGS_RELEASE)
    if("${${flags}}" MATCHES "(^|[ \t])[-/]MTd?([ \t]|$)")
        _cordis_sdk_reject("Cordis plugin SDK rejects /MT and /MTd; use the matching dynamic CRT")
    endif()
endforeach()
foreach(component IN LISTS Cordis_FIND_COMPONENTS)
    if(NOT component MATCHES "^(Core|Qt|Ui|QtPluginSdk|QtUiPluginSdk)$")
        _cordis_sdk_reject("Unsupported Cordis SDK component: ${component}; host Module/Session libraries are not plugin SDK components")
    endif()
    set(Cordis_${component}_FOUND TRUE)
endforeach()

include(CMakeFindDependencyMacro)
# Save our prefix before dependency configs use PACKAGE_INIT on CMake < 3.30.
set(_cordis_sdk_prefix "${PACKAGE_PREFIX_DIR}")
find_dependency(Threads)
find_dependency(Qt5 5.15.2 EXACT COMPONENTS Core Widgets)
find_dependency(ElaWidgetTools 2.0.0 EXACT CONFIG
    PATHS "${_cordis_sdk_prefix}/ElaWidgetTools/lib/cmake" NO_DEFAULT_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/CordisTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CordisPlugin.cmake")
check_required_components(Cordis)
