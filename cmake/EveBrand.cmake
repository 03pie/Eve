# 所有桌面入口共用正式 Eve ICO；Qt 窗口图标仍由共享 Ui 资源提供。
function(cordis_attach_eve_icon target)
    if(NOT WIN32)
        return()
    endif()
    if(NOT TARGET ${target})
        message(FATAL_ERROR "Eve icon requires an existing target: ${target}")
    endif()
    set(CORDIS_EVE_ICON_FILE "${PROJECT_SOURCE_DIR}/app/shell/resources/eve.ico")
    set(resource "${CMAKE_CURRENT_BINARY_DIR}/${target}_eve.rc")
    configure_file("${PROJECT_SOURCE_DIR}/app/shell/resources/eve.rc.in" "${resource}" @ONLY)
    set_source_files_properties("${resource}" PROPERTIES OBJECT_DEPENDS "${CORDIS_EVE_ICON_FILE}")
    target_sources(${target} PRIVATE "${resource}")
endfunction()
