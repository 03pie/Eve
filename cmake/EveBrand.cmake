# 桌面入口共用 Eve ICO，桌面插件通过同一组品牌资源设置 Qt 窗口图标。
function(eve_attach_icon target)
    if(NOT WIN32)
        return()
    endif()
    if(NOT TARGET ${target})
        message(FATAL_ERROR "Eve icon requires an existing target: ${target}")
    endif()
    set(EVE_ICON_FILE "${PROJECT_SOURCE_DIR}/app/shell/resources/eve.ico")
    set(resource "${CMAKE_CURRENT_BINARY_DIR}/${target}_eve.rc")
    configure_file("${PROJECT_SOURCE_DIR}/app/shell/resources/eve.rc.in" "${resource}" @ONLY)
    set_source_files_properties("${resource}" PROPERTIES OBJECT_DEPENDS "${EVE_ICON_FILE}")
    target_sources(${target} PRIVATE "${resource}")
endfunction()
