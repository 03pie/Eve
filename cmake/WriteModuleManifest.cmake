# Generate the digest only after linking the actual DLL, including Debug/ASan builds.
foreach(required LIBRARY MODULE_ID PLUGIN_ID)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT DEFINED LOADER)
    set(LOADER "c-abi")
endif()
if(NOT DEFINED MODULE_VERSION)
    set(MODULE_VERSION "1.0.0")
endif()
if(NOT DEFINED UNLOAD_POLICY)
    set(UNLOAD_POLICY "resident")
endif()
string(LENGTH "${MODULE_VERSION}" version_length)
if(version_length GREATER 64 OR NOT MODULE_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "MODULE_VERSION must contain three canonical decimal components")
endif()
if(NOT UNLOAD_POLICY STREQUAL "resident" AND NOT UNLOAD_POLICY STREQUAL "explicit")
    message(FATAL_ERROR "UNLOAD_POLICY must be resident or explicit")
endif()
if(UNLOAD_POLICY STREQUAL "explicit" AND NOT LOADER STREQUAL "c-abi")
    message(FATAL_ERROR "Only C ABI modules support explicit unload policy")
endif()
file(SHA256 "${LIBRARY}" digest)
get_filename_component(directory "${LIBRARY}" DIRECTORY)
get_filename_component(name "${LIBRARY}" NAME)
file(WRITE "${directory}/module.json"
    "{\n  \"manifestVersion\": 1,\n  \"moduleId\": \"${MODULE_ID}\",\n  \"moduleVersion\": \"${MODULE_VERSION}\",\n  \"loader\": \"${LOADER}\",\n  \"library\": \"${name}\",\n  \"sha256\": \"${digest}\",\n  \"platform\": \"windows-x64\",\n  \"abi\": {\"major\": 1, \"minor\": 0},\n  \"plugins\": [\"${PLUGIN_ID}\"],\n  \"unloadPolicy\": \"${UNLOAD_POLICY}\"\n}\n")
