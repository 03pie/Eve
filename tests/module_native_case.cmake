foreach(required TEST_EXE TEST_ROOT CASE FIXTURES)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT CASE MATCHES "^[a-z_]+$")
    message(FATAL_ERROR "Invalid case name")
endif()
get_filename_component(base "${TEST_ROOT}" ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef invocation)
set(directory "${base}/${CASE}-${invocation}")
get_filename_component(target "${directory}" ABSOLUTE)
string(FIND "${target}/" "${base}/" prefix)
if(NOT prefix EQUAL 0 OR target STREQUAL base)
    message(FATAL_ERROR "Fixture is outside the named test root")
endif()
if(EXISTS "${target}")
    message(FATAL_ERROR "Fixture already exists; refusing to reuse it")
endif()
file(MAKE_DIRECTORY "${target}")
execute_process(COMMAND "${TEST_EXE}" "${CASE}" "${target}" "${FIXTURES}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
# DLLs are pinned until the child exits. Only then remove its dedicated fixture.
file(REAL_PATH "${target}" resolved)
if(NOT resolved STREQUAL target)
    message(FATAL_ERROR "Unexpected fixture redirection; cleanup refused")
endif()
file(REMOVE_RECURSE "${target}")
if(EXISTS "${target}")
    message(FATAL_ERROR "Fixture cleanup failed after child exit: ${target}")
endif()
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Native module case ${CASE}: ${result}\n${output}\n${errors}")
endif()
