cmake_minimum_required(VERSION 3.21)
file(REAL_PATH "@CMAKE_CURRENT_BINARY_DIR@" test_dir)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(scratch "${test_dir}/consumer-${suffix}")
set(sdk "${scratch}/sdk")
set(build "${scratch}/build")
set(eve_dir "${sdk}/@CMAKE_INSTALL_LIBDIR@/cmake/Eve")
set(share "${sdk}/@CMAKE_INSTALL_DATADIR@/Eve")
set(template "${share}/templates/qt-ui-plugin")
foreach(directory IN ITEMS "@CMAKE_INSTALL_BINDIR@" "@CMAKE_INSTALL_LIBDIR@" "@CMAKE_INSTALL_INCLUDEDIR@" "@CMAKE_INSTALL_DATADIR@")
    cmake_path(APPEND sdk "${directory}" OUTPUT_VARIABLE destination)
    cmake_path(IS_PREFIX sdk "${destination}" NORMALIZE private_install)
    if(IS_ABSOLUTE "${directory}" OR NOT private_install)
        message(FATAL_ERROR "The SDK consumer test requires install paths inside its private SDK prefix.")
    endif()
endforeach()
if(EXISTS "${scratch}")
    message(FATAL_ERROR "The SDK consumer test directory already exists: ${scratch}")
endif()
message(STATUS "SDK consumer test directory: ${scratch}")

execute_process(COMMAND "${CMAKE_COMMAND}" --install "${HOST_BUILD}" --config "${HOST_CONFIG}"
    --prefix "${sdk}" COMMAND_ERROR_IS_FATAL ANY)
if(NOT EXISTS "${eve_dir}/EveConfig.cmake" OR NOT EXISTS "${template}/CMakeLists.txt")
    message(FATAL_ERROR "The staged SDK is missing its package config or Qt plugin template.")
endif()

foreach(document IN ITEMS sdk-consumer.md docs/sdk-consumer.md THIRD_PARTY_NOTICES.md third_party/ela/UPSTREAM.md)
    file(READ "${share}/${document}" content)
    get_filename_component(parent "${share}/${document}" DIRECTORY)
    while(content MATCHES "\\]\\(([^)\n]+)\\)")
        set(link "${CMAKE_MATCH_0}")
        set(destination "${CMAKE_MATCH_1}")
        if(NOT destination MATCHES "^https?://" AND NOT EXISTS "${parent}/${destination}")
            message(FATAL_ERROR "${document} has a missing installed link: ${destination}")
        endif()
        string(REPLACE "${link}" "" content "${content}")
    endwhile()
endforeach()

# 只修改外部工程中的构建声明，检查边界长度和 CMake 布尔文字均能传到真实工厂。
set(consumer "${scratch}/consumer")
file(COPY "${template}/" DESTINATION "${consumer}")
file(READ "${consumer}/CMakeLists.txt" project)
string(REPEAT "x" 127 tail)
set(module_id "A${tail}")
string(REPLACE "MODULE_ID org.example.eve.page" "MODULE_ID ${module_id}" project "${project}")
string(REPLACE "PLUGIN_ID example.page" "PLUGIN_ID OFF" project "${project}")
file(WRITE "${consumer}/CMakeLists.txt" "${project}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${consumer}" -B "${build}" -G "${HOST_GENERATOR}"
    "-DCMAKE_MAKE_PROGRAM=${HOST_MAKE_PROGRAM}" "-DCMAKE_CXX_COMPILER=${HOST_CXX_COMPILER}"
    "-DCMAKE_BUILD_TYPE=${HOST_CONFIG}" "-DQt5_DIR=${HOST_QT_DIR}" "-DEve_DIR=${eve_dir}"
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --config "${HOST_CONFIG}"
    COMMAND_ERROR_IS_FATAL ANY)
set(manifest "${build}/module/external_page/module.json")
file(READ "${manifest}" json)
string(JSON actual_module GET "${json}" moduleId)
string(JSON actual_plugin GET "${json}" plugins 0)
if(NOT actual_module STREQUAL module_id OR NOT actual_plugin STREQUAL "OFF")
    message(FATAL_ERROR "Consumer-specified IDs did not reach the module manifest.")
endif()
foreach(mode IN ITEMS create reopen)
    execute_process(COMMAND "${TEST_EXE}" "${manifest}" "${scratch}/workspace" "${mode}"
        COMMAND_ERROR_IS_FATAL ANY)
endforeach()

# Compile a desktop using only the staged public SDK and install its generated archive.
set(desktop_build "${scratch}/desktop-build")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${share}/templates/desktop" -B "${desktop_build}" -G "${HOST_GENERATOR}"
    "-DCMAKE_MAKE_PROGRAM=${HOST_MAKE_PROGRAM}" "-DCMAKE_CXX_COMPILER=${HOST_CXX_COMPILER}"
    "-DCMAKE_BUILD_TYPE=${HOST_CONFIG}" "-DQt5_DIR=${HOST_QT_DIR}" "-DEve_DIR=${eve_dir}"
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${desktop_build}" --target external_desktop_package
    COMMAND_ERROR_IS_FATAL ANY)
foreach(mode IN ITEMS install safe selected selected unacknowledged recovered)
    execute_process(COMMAND "${DESKTOP_TEST_EXE}" "${desktop_build}/external_desktop.evepkg" "${scratch}/desktop-workspace" "${mode}"
        COMMAND_ERROR_IS_FATAL ANY)
endforeach()

# A normal Qt factory with a valid image/manifest cannot impersonate the desktop contract.
file(READ "${consumer}/package.json" descriptor)
string(REPLACE "\"business\"" "\"desktop\"" descriptor "${descriptor}")
file(WRITE "${consumer}/package.json" "${descriptor}")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --target external_page_package COMMAND_ERROR_IS_FATAL ANY)
foreach(mode IN ITEMS install incompatible recovered)
    execute_process(COMMAND "${DESKTOP_TEST_EXE}" "${build}/external_page.evepkg" "${scratch}/desktop-workspace" "${mode}"
        COMMAND_ERROR_IS_FATAL ANY)
endforeach()

file(REAL_PATH "${scratch}" actual_scratch)
if(NOT actual_scratch STREQUAL scratch)
    message(FATAL_ERROR "The SDK consumer test directory moved: ${scratch}")
endif()
file(REMOVE_RECURSE "${scratch}")
