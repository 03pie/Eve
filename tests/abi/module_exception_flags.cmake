include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/ModuleExceptionModel.cmake")
function(check_flags)
    set(MSVC TRUE)
    set(CMAKE_BUILD_TYPE Custom)
    set(CMAKE_CONFIGURATION_TYPES "Debug;Release;Profile")
    set(CMAKE_CXX_FLAGS "/EHsc /EHsc\t-EHsc /EHsc- /EHs- /EHa /DKEEP")
    set(CMAKE_CXX_FLAGS_DEBUG "/Zi /EHsc")
    set(CMAKE_CXX_FLAGS_RELEASE "/EHsc- /O2")
    set(CMAKE_CXX_FLAGS_CUSTOM "/EHsc")
    set(CMAKE_CXX_FLAGS_PROFILE "-EHsc")
    cordis_module_exception_model()
    if(NOT CMAKE_CXX_FLAGS STREQUAL "/EHs /EHs\t-EHs /EHsc- /EHs- /EHa /DKEEP"
        OR NOT CMAKE_CXX_FLAGS_DEBUG STREQUAL "/Zi /EHs"
        OR NOT CMAKE_CXX_FLAGS_RELEASE STREQUAL "/EHsc- /O2"
        OR NOT CMAKE_CXX_FLAGS_CUSTOM STREQUAL "/EHs"
        OR NOT CMAKE_CXX_FLAGS_PROFILE STREQUAL "-EHs")
        message(FATAL_ERROR "Module exception flags corrupted or configuration omitted")
    endif()
    set(MSVC FALSE)
    set(CMAKE_CXX_FLAGS "/EHsc")
    cordis_module_exception_model()
    if(NOT CMAKE_CXX_FLAGS STREQUAL "/EHsc")
        message(FATAL_ERROR "Non-MSVC flags changed")
    endif()
endfunction()
set(CMAKE_CXX_FLAGS "/EHsc outer")
check_flags()
if(NOT CMAKE_CXX_FLAGS STREQUAL "/EHsc outer")
    message(FATAL_ERROR "Flags escaped caller scope")
endif()
